# Copy to .env for local dev (never commit the real .env).
# On Northflank, set these as service secrets/env vars instead.

# From @BotFather
TELEGRAM_TOKEN=123456:abcdef

# From your Northflank Postgres addon
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Which store to automate: blinkit | zepto
PLATFORM=blinkit

# Your Telegram group chat id(s), comma-separated. Send `chatid` to the bot to learn it.
# Leave empty in local dev to allow all chats.
ALLOWED_CHAT_IDS=

# Where "session dead" alerts are DM'd (your personal chat id).
ADMIN_CHAT_ID=

# Where the logged-in session is stored. In the container this is the mounted volume.
SESSION_PATH=/data/storage_state.json

# Local dev only: watch the browser during seeding / debugging.
HEADLESS=true

HEALTH_PORT=8080
