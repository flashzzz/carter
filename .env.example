# Copy to .env for local dev (never commit the real .env).
# On Northflank, set these as service secrets/env vars instead.

# From @BotFather
TELEGRAM_TOKEN=123456:abcdef

# From your Northflank Postgres addon
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Which store to automate: blinkit | zepto
PLATFORM=blinkit

# Guest delivery location — a pincode or locality. No login/OTP needed; Blinkit
# only needs a delivery location to browse, cart, and share. e.g. 411057
BLINKIT_LOCATION=411057

# Your Telegram group chat id(s), comma-separated. Send `chatid` to the bot to learn it.
# Leave empty in local dev to allow all chats.
ALLOWED_CHAT_IDS=

# Where health-check alerts are DM'd (your personal chat id). Optional.
ADMIN_CHAT_ID=

# Local dev only: watch the browser during debugging.
HEADLESS=true

HEALTH_PORT=8080
